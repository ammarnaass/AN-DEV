{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --workspace=@andev/web --workspace=@andev/shared --include-workspace-root",
  "buildCommand": "npm run build --workspace=@andev/web && rm -rf ./dist && cp -r apps/web/dist ./dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
