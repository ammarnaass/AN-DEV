{
  "name": "andev-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,cyan\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@andev/api",
    "dev:web": "npm run dev --workspace=@andev/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "seed": "npm run seed --workspace=@andev/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
